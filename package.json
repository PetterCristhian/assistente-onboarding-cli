{
  "name": "assistente-onboarding-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Chatbot CLI de onboarding com camada de políticas (TypeScript + OpenAI)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "chat": "tsx src/cli/main.ts",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "openai": "^7.57.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
